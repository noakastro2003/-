{
  "rules": {
    ".read": false,
    ".write": false,

    "classes": {
      "$cls": {
        "presence": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 14 && newData.child('rocket').isString())",
            "name":   { ".validate": "newData.isString() && newData.val().length <= 14" },
            "rocket": { ".validate": "newData.isString() && newData.val().length <= 10" },
            "ts":     { ".validate": "newData.isNumber()" },
            "busy":   { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "invites": {
          "$to": {
            ".read": "auth != null && auth.uid === $to",
            "$room": {
              ".write": "auth != null && (auth.uid === $to || (!data.exists() && !newData.exists()) || (!data.exists() && newData.child('from').val() === auth.uid) || (data.exists() && data.child('from').val() === auth.uid))",
              ".validate": "!newData.exists() || (newData.child('from').isString() && newData.child('name').isString() && newData.child('name').val().length <= 14 && newData.child('level').isNumber() && newData.child('ts').isNumber())"
            }
          }
        }
      }
    },

    "roomIndex": {
      ".read": "auth != null",
      ".indexOn": ".value",
      "$code": {
        ".write": "auth != null && ((!data.exists() && newData.isNumber() && root.child('rooms').child($code).child('host').val() === auth.uid) || (!newData.exists() && (!root.child('rooms').child($code).exists() || root.child('rooms').child($code).child('members').child(auth.uid).exists() || data.val() < now - 86400000)))"
      }
    },

    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.exists() && data.child('members').child(auth.uid).exists()) || (data.exists() && !newData.exists() && data.child('created').val() < now - 86400000))",
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).exists()",
            "name": { ".validate": "newData.isString() && newData.val().length <= 14" }
          }
        },
        "declined": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).exists()",
            ".validate": "newData.isString() && newData.val().length <= 14"
          }
        },
        "reactions": {
          "$uid": {
            ".validate": "newData.child('r').isNumber() && newData.child('r').val() >= 0 && newData.child('r').val() <= 6 && newData.child('ts').isNumber()"
          }
        }
      }
    }
  }
}
